# EntitySpine environment configuration
# Copy to .env and customize

# =============================================================================
# Application
# =============================================================================
ENTITYSPINE_ENV=development
ENTITYSPINE_DEBUG=true
ENTITYSPINE_LOG_LEVEL=INFO

# =============================================================================
# Storage Backend
# =============================================================================
# Options: json, sqlite, duckdb, postgres
ENTITYSPINE_BACKEND=sqlite
ENTITYSPINE_DB_PATH=./data/entityspine.db

# PostgreSQL (when ENTITYSPINE_BACKEND=postgres)
ENTITYSPINE_POSTGRES_HOST=localhost
ENTITYSPINE_POSTGRES_PORT=5432
ENTITYSPINE_POSTGRES_USER=entityspine
ENTITYSPINE_POSTGRES_PASSWORD=entityspine
ENTITYSPINE_POSTGRES_DB=entityspine

# Full DSN (alternative to individual settings)
# ENTITYSPINE_DATABASE_URL=postgresql://entityspine:entityspine@localhost:5432/entityspine

# =============================================================================
# API Server
# =============================================================================
ENTITYSPINE_API_HOST=0.0.0.0
ENTITYSPINE_API_PORT=8000
ENTITYSPINE_API_WORKERS=1
ENTITYSPINE_API_RELOAD=true

# CORS (comma-separated origins)
ENTITYSPINE_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# =============================================================================
# SEC Data
# =============================================================================
# Auto-download company_tickers.json if missing
ENTITYSPINE_AUTO_DOWNLOAD=true
ENTITYSPINE_SEC_USER_AGENT=EntitySpine/1.0 (research)

# Path to company_tickers.json (optional, auto-detected)
# ENTITYSPINE_JSON_PATH=./data/company_tickers.json

# =============================================================================
# Optional: Elasticsearch (Tier 3+)
# =============================================================================
# ENTITYSPINE_ELASTICSEARCH_URL=http://localhost:9200
# ENTITYSPINE_ELASTICSEARCH_INDEX=entities

# =============================================================================
# Optional: Redis (caching)
# =============================================================================
# ENTITYSPINE_REDIS_URL=redis://localhost:6379/0
